LINKEDIN_CLIENT_ID=REPLACE_ME
# Recommended for apps that do not have LinkedIn native PKCE enabled.
# If set, the MCP uses regular 3-legged OAuth instead of native PKCE.
# LINKEDIN_CLIENT_SECRET=REPLACE_ME
# LINKEDIN_OAUTH_FLOW=authorization_code
# LINKEDIN_REDIRECT_URI=http://127.0.0.1:63141/callback
LINKEDIN_SCOPES=r_dma_portability_self_serve
# Marketing/engagement version. Member Snapshot requests always use 202312.
LINKEDIN_API_VERSION=202610
LINKEDIN_RESTLI_PROTOCOL_VERSION=2.0.0
LINKEDIN_TIMEOUT_SECONDS=30
LINKEDIN_MAX_RETRIES=3
LINKEDIN_OAUTH_TIMEOUT_SECONDS=300
# Optional. Defaults to ~/.flin-linkedin-posts-mcp/tokens.json
# LINKEDIN_TOKEN_FILE=/absolute/path/to/tokens.json
# Optional separate Community Management app for personal analytics.
# Configure its own credentials; register this callback in the second app.
# LINKEDIN_ANALYTICS_CLIENT_ID=REPLACE_ME
# LINKEDIN_ANALYTICS_CLIENT_SECRET=REPLACE_ME
# LINKEDIN_ANALYTICS_REDIRECT_URI=http://127.0.0.1:63142/callback
# LINKEDIN_ANALYTICS_SCOPES=r_member_postAnalytics
# For follower statistics, add r_member_profileAnalytics and log in again.
# Tokens default to a separate tokens.analytics.json file.
RUN_LIVE_LINKEDIN_TESTS=0
